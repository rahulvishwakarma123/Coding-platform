{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  // "include": ["src"],
  // "exclude": ["node_modules"],
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "strict": true,
    "outDir": "./dist",
    "baseUrl": ".",           // <-- IMPORTANT: Must be set for paths to work
    "paths": {
      "@/*": ["./src/*"],
      "@components/*": ["./src/components/*"],
      "@features/*": ["./src/features/*"],
      "@hooks/*": ["./src/hooks/*"],
      "@utils/*": ["./src/utils/*"],
      "@types/*": ["./src/types/*"]
    }
  },

}
